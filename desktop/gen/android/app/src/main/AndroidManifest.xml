<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Run survival: keep long agent turns alive when backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Device capabilities (mobile-migration §4.1): camera / geolocation / haptics -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Voice input: SpeechRecognizer bridge (SpeechPlugin) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.syscity_desktop"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".AgentRuntimeService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- The agent's eyes on other apps. Gated by the system's own
             accessibility grant: the user switches it on in Settings ›
             Accessibility, and `BIND_ACCESSIBILITY_SERVICE` keeps any other
             app from binding to it. Declared with `exported="true"` because
             that is how the system reaches a service of this kind. -->
        <service
            android:name=".SyscityAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Where the shell-side display helper's Binder lands.

             `exported="true"` because the caller is a different uid (shell,
             2000) — and `INTERACT_ACROSS_USERS_FULL` is what keeps ordinary
             apps out, since only shell and system hold it. The provider's own
             checks then decide whether the shell that called is *our* helper:
             uid, pid, APK path, signing certificate and a single-use nonce. -->
        <provider
            android:name=".shell.ShellHandoffProvider"
            android:authorities="${applicationId}.shell"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
